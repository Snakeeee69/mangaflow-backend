# --- Etapa 1: Compilación ---
FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /app

# Copiar el wrapper de Maven y el archivo pom.xml para descargar dependencias
COPY .mvn/ .mvn
COPY mvnw pom.xml ./

# Dar permisos de ejecución al script de Maven (crucial para entornos Linux/Docker)
RUN chmod +x mvnw

# Descargar dependencias para aprovechar la caché de Docker
RUN ./mvnw dependency:go-offline -B

# Copiar el código fuente y compilar el archivo JAR omitiendo los tests
COPY src ./src
RUN ./mvnw clean package -DskipTests

# --- Etapa 2: Imagen de producción ---
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# Copiar el archivo JAR generado en la etapa anterior
COPY --from=build /app/target/*.jar app.jar

# NOTA: Cambia este puerto según el microservicio (Ver tabla abajo)
EXPOSE 8087

# Comando para ejecutar la aplicación
ENTRYPOINT ["java", "-jar", "app.jar"]